# HostelFlow Environment Configuration Template (.env.example)
# Copy this template to .env and configure values for your environment.

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-secret-key-here

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostelflow_db
DB_USER=your_database_user_here
DB_PASSWORD=your_database_password_here
